<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>RestSharp</AssemblyName>
    <RootNamespace>RestSharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1570;CS1572;CS1573;CS1574;CS1584;CS1658;SYSLIB0014</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Version>103.0.0</Version>
    <AssemblyTitle>RestSharp</AssemblyTitle>
    <Product>RestSharp</Product>
    <Company>RestSharp Community</Company>
    <Authors>John Sheehan, RestSharp Community</Authors>
    <Description>Simple REST and HTTP API client.</Description>
    <Copyright>Copyright © RestSharp Project</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>RestSharp</PackageId>
    <PackageTags>REST;HTTP;API;JSON;XML</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/COG-GTM/RestSharp-.NET-2.0-Fork</PackageProjectUrl>
    <RepositoryUrl>https://github.com/COG-GTM/RestSharp-.NET-2.0-Fork</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="T4Helper\**" />
    <None Include="T4Helper\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RestSharp.IntegrationTests" />
    <InternalsVisibleTo Include="RestSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
